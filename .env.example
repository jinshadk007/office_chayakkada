# Server-side only. Enter real credentials in Vercel environment settings.
# No VITE_ prefix: secret keys must never enter the browser bundle.
SUPABASE_URL=
# Use the Supabase project's secret key (sb_secret_...), or the legacy key below.
SUPABASE_SECRET_KEY=
# Legacy alternative; leave empty when using SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
# Leave all unset for local development with SQLite.

# Public browser configuration (publishable key only, never a secret/service key).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional server equivalents. The API also accepts the VITE_ public values above.
SUPABASE_PUBLISHABLE_KEY=
